# Cross-compile toolchain: Linux host -> Windows x64 using llvm-mingw (https://github.com/mstorsjo/llvm-mingw)
# Usage: cmake -DCMAKE_TOOLCHAIN_FILE=cmake/llvm-mingw-x64.cmake -DLLVM_MINGW_ROOT=/path/to/llvm-mingw ...
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if (NOT LLVM_MINGW_ROOT)
    set(LLVM_MINGW_ROOT "$ENV{LLVM_MINGW_ROOT}")
endif()
set(_p "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32")
set(CMAKE_C_COMPILER   "${_p}-clang")
set(CMAKE_CXX_COMPILER "${_p}-clang++")
set(CMAKE_RC_COMPILER  "${_p}-windres")
set(CMAKE_AR           "${LLVM_MINGW_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB       "${LLVM_MINGW_ROOT}/bin/llvm-ranlib")
set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
# Fully static runtime: the .exe / .vst3 need no MinGW DLLs on the target machine
set(CMAKE_EXE_LINKER_FLAGS_INIT    "-static")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-static")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-static")
